## /etc/systemd/system/web-server.service ##

[Unit]
Description=My Python HTTP Server
After=network.target

[Service]
Type=simple
User=karem
WorkingDirectory=/home/karem/web-server
ExecStart=/usr/bin/python3 /home/karem/web-server/server.py
Restart=always
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target


